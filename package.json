{
  "name": "17-cdn-caching-proxy",
  "version": "1.0.0",
  "description": "RFC 9111 Compliant CDN Caching Proxy",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=--expose-gc vitest run --fileParallelism false",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "tsc",
    "config:check": "tsx src/config/cli.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.64.1",
    "selfsigned": "^2.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "vitepress": "^1.6.3",
    "mermaid": "^11.4.1",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}